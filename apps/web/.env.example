# Produção (Netlify): copia estas chaves para Site configuration → Environment variables
# e faz um novo deploy (Clear cache and deploy). O .env local não vai para o Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Opcional: emails extra de super-admin, separados por vírgula (o email em superAdmin.ts entra sempre).
# Deve coincidir com firebase/firestore.rules para esse email ter permissões no Firestore.
# VITE_SUPER_ADMIN_EMAIL=
